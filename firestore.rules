rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{userId} {
      // Los perfiles son públicos (listado y página de detalle)
      allow read: if true;

      // Cada usuario crea solo su propio perfil
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId;

      // El dueño edita su perfil; cualquier otro solo puede sumar 1 a "visitas"
      allow update: if (request.auth != null && request.auth.uid == userId)
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitas'])
                        && request.resource.data.visitas == resource.data.get('visitas', 0) + 1);

      // Solo el dueño puede borrar su perfil
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
